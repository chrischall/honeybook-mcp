{
  "name": "honeybook-mcp",
  "version": "1.1.3",
  "mcpName": "io.github.chrischall/honeybook-mcp",
  "description": "HoneyBook client-portal MCP server for Claude",
  "author": "Claude Code (AI) <https://www.anthropic.com/claude>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrischall/honeybook-mcp.git"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "honeybook",
    "wedding",
    "contracts",
    "invoices",
    "model-context-protocol",
    "claude",
    "messages",
    "meetings"
  ],
  "files": [
    "dist",
    ".claude-plugin",
    "skills",
    ".mcp.json",
    "server.json",
    "mint.yaml"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "bin": {
    "honeybook-mcp": "dist/bundle.js"
  },
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "esbuild src/index.ts --bundle --alias:zod/v4=./node_modules/zod/v4/index.cjs --platform=node --format=esm --external:dotenv --banner:js='import { createRequire as __createRequire } from \"module\"; const require = __createRequire(import.meta.url);' --outfile=dist/bundle.js",
    "dev": "node --env-file=.env dist/index.js",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@chrischall/mcp-utils": "^2.4.0",
    "@fetchproxy/bootstrap": "^3.2.0",
    "@fetchproxy/server": "^3.2.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "dotenv": "^17.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
